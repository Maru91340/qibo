<view class="page">
  <view class="searchbar">
    <t-search
      value="{{keyword}}"
      focus
      shape="round"
      placeholder="搜奇波、角色、板块"
      bind:change="onKeywordChange"
      bind:clear="onClear"
    />
  </view>

  <view class="history" wx:if="{{!keyword}}">
    <view class="section-title">
      <text>最近搜索</text>
      <text class="section-title__more" wx:if="{{history.length}}" bindtap="clearHistory">清空</text>
    </view>
    <view class="chip-row" wx:if="{{history.length}}">
      <text class="chip" wx:for="{{history}}" wx:key="*this" data-value="{{item}}" bindtap="useKeyword">{{item}}</text>
    </view>
    <view class="text-muted" wx:else>还没有搜索记录</view>
  </view>

  <block wx:if="{{keyword}}">
    <view class="list-head">
      <text>找到 {{total}} 条结果</text>
      <text class="text-muted">关键词：{{keyword}}</text>
    </view>
    <view class="group" wx:for="{{groups}}" wx:key="title">
      <view class="group__title">{{item.title}}</view>
      <view class="entry-list">
        <view
          class="entry-card card"
          wx:for="{{item.items}}"
          wx:for-item="entry"
          wx:key="id"
          data-path="{{entry.path}}"
          bindtap="goResult"
        >
          <view class="entry-card__badge entry-card__badge--soft">
            <t-icon name="{{entry.icon}}" size="34rpx" color="#2f6bff" />
          </view>
          <view class="entry-card__body">
            <view class="entry-card__title">{{entry.name}}</view>
            <view class="entry-card__desc entry-card__desc--last">{{entry.desc}}</view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#c2c9d6" />
        </view>
      </view>
    </view>
    <t-empty wx:if="{{!total}}" description="没有找到相关内容" />
  </block>
</view>
