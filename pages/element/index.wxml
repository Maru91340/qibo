<view class="page">
  <view class="tip hero">
    <view class="hero__inner">
      <view class="tip__title">元素克制速查</view>
      <view class="tip__desc">选择一个元素，查看它克制与被克制的关系；表格为全元素两两倍率。</view>
    </view>
  </view>

  <view class="element-row element-row--pick">
    <view
      class="element-pill {{item.key === current ? 'element-pill--active' : ''}}"
      wx:for="{{elements}}"
      wx:key="key"
      data-value="{{item.key}}"
      bindtap="onPick"
    >
      <view class="element-pill__dot" style="background: {{item.color}};">{{item.name}}</view>
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="panel card">
    <view class="panel__title">
      <text>{{currentElement.label}}的相克关系</text>
      <text class="text-muted">倍率 {{strong.ratio}}x / {{weak.ratio}}x</text>
    </view>
    <view class="rel">
      <view class="rel__col rel__col--strong">
        <text class="rel__label">克制</text>
        <view class="rel__list">
          <text class="rel__item" wx:for="{{strong.list}}" wx:key="key" style="background: {{item.tint}}; color: {{item.color}};">
            {{item.label}}
          </text>
          <text class="rel__item rel__item--none" wx:if="{{!strong.list.length}}">无</text>
        </view>
      </view>
      <view class="rel__col">
        <text class="rel__label">被克制</text>
        <view class="rel__list">
          <text class="rel__item" wx:for="{{weak.list}}" wx:key="key" style="background: {{item.tint}}; color: {{item.color}};">
            {{item.label}}
          </text>
          <text class="rel__item rel__item--none" wx:if="{{!weak.list.length}}">无</text>
        </view>
      </view>
    </view>
  </view>

  <view class="panel card">
    <view class="panel__title">克制矩阵</view>
    <view class="matrix">
      <view class="matrix__row matrix__row--head">
        <view class="matrix__corner">攻\防</view>
        <view class="matrix__cell matrix__cell--head" wx:for="{{matrixCols}}" wx:key="key" style="color: {{item.color}};">
          {{item.name}}
        </view>
      </view>
      <view class="matrix__row" wx:for="{{matrix}}" wx:key="key">
        <view class="matrix__label" style="color: {{item.color}};">{{item.name}}</view>
        <view
          class="matrix__cell matrix__cell--{{cell.key}}"
          wx:for="{{item.cells}}"
          wx:for-item="cell"
          wx:key="id"
        >
          {{cell.key === 'self' ? '—' : cell.ratio}}
        </view>
      </view>
    </view>
    <view class="legend">
      <text class="legend__item"><text class="legend__swatch legend__swatch--strong" />克制 1.5</text>
      <text class="legend__item"><text class="legend__swatch legend__swatch--neutral" />中立 1</text>
      <text class="legend__item"><text class="legend__swatch legend__swatch--weak" />被克 0.75</text>
    </view>
  </view>

  <view class="panel card" wx:if="{{team.elements.length}}">
    <view class="panel__title">当前队伍对「{{currentElement.label}}」目标</view>
    <view class="team-line">
      <text class="team-line__name" wx:for="{{team.elements}}" wx:key="key">{{item.label}}</text>
    </view>
    <view class="panel__desc panel__desc--first">
      队伍中 {{team.strongCount}} 名可克制该目标，{{team.weakCount}} 名会被反制。
    </view>
  </view>

  <view class="footnote">{{notice}}</view>
</view>
