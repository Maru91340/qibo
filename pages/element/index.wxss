.tip {
  margin-bottom: 24rpx;
  padding: 36rpx 40rpx;
}

.tip__title {
  font-size: 36rpx;
  font-weight: 700;
}

.tip__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  opacity: 0.88;
}

.element-row--pick {
  margin-bottom: 24rpx;
}

.panel__title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.rel {
  display: flex;
  gap: 20rpx;
}

.rel__col {
  flex: 1;
}

.rel__label {
  color: var(--ink-3);
  font-size: 22rpx;
}

.rel__list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.rel__item {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.rel__item--none {
  background: #f2f4f9;
  color: var(--ink-3);
  font-weight: 400;
}

.matrix {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #f7f9fd;
}

.matrix__row {
  display: flex;
}

.matrix__row--head {
  background: #eef2fa;
}

.matrix__corner,
.matrix__label {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 72rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.matrix__corner {
  color: var(--ink-3);
  font-size: 20rpx;
}

.matrix__cell {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-left: 1rpx solid #fff;
  border-top: 1rpx solid #fff;
  font-size: 22rpx;
  color: var(--ink-3);
}

.matrix__cell--head {
  border-top: none;
  font-size: 26rpx;
  font-weight: 700;
}

.matrix__cell--strong {
  background: #e5f6ec;
  color: #16813f;
  font-weight: 600;
}

.matrix__cell--weak {
  background: #fdecec;
  color: #c93b3b;
  font-weight: 600;
}

.matrix__cell--self {
  background: #eef2fa;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 26rpx;
  margin-top: 20rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.legend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend__swatch {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
}

.legend__swatch--strong {
  background: #e5f6ec;
}

.legend__swatch--neutral {
  background: #f7f9fd;
}

.legend__swatch--weak {
  background: #fdecec;
}

.team-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.team-line__name {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 24rpx;
}
