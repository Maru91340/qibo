.banner-wrap {
  position: relative;
  padding-top: 8rpx;
}

.banner {
  height: 320rpx;
}

.banner__card {
  box-sizing: border-box;
  height: 300rpx;
  padding: 40rpx 44rpx;
}

.banner__tag {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.banner__title {
  margin-top: 26rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.banner__desc {
  margin-top: 14rpx;
  max-width: 440rpx;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.86;
}

.banner__cta {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 28rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
}

.banner__dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 18rpx 0 28rpx;
}

.banner__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c9d2e8;
  transition: all 0.3s ease;
}

.banner__dot--active {
  width: 34rpx;
  border-radius: 999rpx;
  background: var(--brand);
}

.searchbar {
  padding: 4rpx 0 24rpx;
}

.sections {
  margin-top: 4rpx;
}

.section-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 250rpx;
  padding: 28rpx 26rpx;
}

.section-card__glow {
  position: absolute;
  right: -60rpx;
  bottom: -70rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  filter: blur(6rpx);
}

.section-card__top {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.section-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
}

.section-card__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f4f6fb;
}

.section-card__title {
  position: relative;
  margin-top: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.section-card__desc {
  position: relative;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--ink-2);
}
