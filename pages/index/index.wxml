<view class="page">
  <view class="banner-wrap">
    <swiper class="banner" circular autoplay interval="5000" duration="400" bind:change="onBannerChange">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner__card hero" data-path="{{item.path}}" bindtap="onBannerTap">
          <view class="hero__inner">
            <text class="banner__tag">{{item.tag}}</text>
            <view class="banner__title">{{item.title}}</view>
            <view class="banner__desc">{{item.desc}}</view>
            <view class="banner__cta">
              <text>立即查看</text>
              <t-icon name="chevron-right" size="28rpx" color="#ffffff" />
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="banner__dots">
      <view
        class="banner__dot {{index === bannerIndex ? 'banner__dot--active' : ''}}"
        wx:for="{{banners}}"
        wx:key="id"
      />
    </view>
  </view>

  <view class="searchbar">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜奇波、角色、元素、板块"
      bind:change="onKeywordChange"
      bind:submit="onSearchSubmit"
    />
  </view>

  <t-notice-bar content="{{notice}}" theme="warning" prefix-icon="info-circle" />

  <view class="section-title">
    <text>功能板块</text>
    <text class="section-title__more">共 {{sections.length}} 个</text>
  </view>

  <view class="grid-2">
    <view
      class="section-card card"
      wx:for="{{sections}}"
      wx:key="key"
      data-path="{{item.path}}"
      bindtap="onSectionTap"
    >
      <view class="section-card__glow" style="background: {{item.glow}};" />
      <view class="section-card__top">
        <view class="section-card__icon" style="color: {{item.accent}}; background: {{item.tint}};">
          <t-icon name="{{item.icon}}" size="40rpx" color="{{item.accent}}" />
        </view>
        <view class="section-card__arrow">
          <t-icon name="chevron-right" size="26rpx" color="#97a0b5" />
        </view>
      </view>
      <view class="section-card__title">{{item.title}}</view>
      <view class="section-card__desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="footnote">{{version}}</view>
</view>
