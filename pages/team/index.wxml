<view class="page">
  <view class="team-head card">
    <view class="team-head__row">
      <view class="team-head__name">{{team.name}}</view>
      <text class="team-head__edit" bindtap="rename">改名</text>
    </view>
    <view class="team-head__meta">
      <text>{{team.members.length}}/{{maxMembers}} 角色</text>
      <text class="dot">·</text>
      <text>{{team.qibos.length}}/{{maxQibo}} 奇波</text>
      <text class="dot">·</text>
      <text>{{updatedText}}</text>
    </view>
    <view class="coverage">
      <view class="coverage__item" wx:for="{{summary.elements}}" wx:key="key">
        <view class="coverage__dot" style="background: {{item.color}};">{{item.name}}</view>
        <text>{{item.label}}</text>
      </view>
      <text class="coverage__empty" wx:if="{{!summary.elements.length}}">尚未编入任何元素</text>
    </view>
  </view>

  <view class="section-title">
    <text>角色位</text>
    <text class="section-title__more">{{summary.coverage}}</text>
  </view>

  <view class="slots">
    <block wx:for="{{memberViews}}" wx:key="key">
      <view class="slot slot--filled" wx:if="{{item.data}}" data-id="{{item.data.id}}" bindtap="goCharacter">
        <view class="slot__badge" style="color: {{item.elementColor}}; background: {{item.elementTint}};">
          {{item.elementName}}
        </view>
        <view class="slot__name">{{item.data.name}}</view>
        <view class="slot__role">{{item.data.role}}</view>
        <view class="slot__remove" catchtap="removeMember" data-id="{{item.data.id}}">
          <t-icon name="close" size="26rpx" color="#97a0b5" />
        </view>
      </view>
      <view class="slot slot--empty" wx:else data-type="character" bindtap="openPicker">
        <t-icon name="add" size="44rpx" color="#c2c9d6" />
        <text class="slot__hint">添加角色</text>
      </view>
    </block>
  </view>

  <view class="section-title">
    <text>出战奇波</text>
    <text class="section-title__more">影响合击元素</text>
  </view>

  <view class="slots">
    <block wx:for="{{qiboViews}}" wx:key="key">
      <view class="slot slot--filled" wx:if="{{item.data}}" data-id="{{item.data.id}}" bindtap="goQibo">
        <view class="slot__badge" style="color: {{item.elementColor}}; background: {{item.elementTint}};">
          {{item.elementName}}
        </view>
        <view class="slot__name">{{item.data.name}}</view>
        <view class="slot__role">{{item.data.kind}}</view>
        <view class="slot__remove" catchtap="removeQibo" data-id="{{item.data.id}}">
          <t-icon name="close" size="26rpx" color="#97a0b5" />
        </view>
      </view>
      <view class="slot slot--empty" wx:else data-type="qibo" bindtap="openPicker">
        <t-icon name="add" size="44rpx" color="#c2c9d6" />
        <text class="slot__hint">添加奇波</text>
      </view>
    </block>
  </view>

  <view class="panel card">
    <view class="panel__title">编队检查</view>
    <view class="checks">
      <view class="check {{summary.hasCarry ? 'check--ok' : ''}}">
        <t-icon name="{{summary.hasCarry ? 'check-circle-filled' : 'close-circle'}}" size="30rpx" />
        <text>有明确输出位</text>
      </view>
      <view class="check {{summary.hasHealer ? 'check--ok' : ''}}">
        <t-icon name="{{summary.hasHealer ? 'check-circle-filled' : 'close-circle'}}" size="30rpx" />
        <text>有生存位（辅助/坦克）</text>
      </view>
      <view class="check {{summary.elementCount >= 3 ? 'check--ok' : ''}}">
        <t-icon name="{{summary.elementCount >= 3 ? 'check-circle-filled' : 'close-circle'}}" size="30rpx" />
        <text>元素覆盖 ≥ 3 系</text>
      </view>
      <view class="check {{team.qibos.length ? 'check--ok' : ''}}">
        <t-icon name="{{team.qibos.length ? 'check-circle-filled' : 'close-circle'}}" size="30rpx" />
        <text>已带出战奇波</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <t-button theme="primary" variant="outline" size="medium" bind:tap="openPicker" data-type="character">
      继续添加角色
    </t-button>
    <t-button theme="default" variant="text" size="medium" bind:tap="clearTeam">清空队伍</t-button>
  </view>

  <t-empty wx:if="{{!team.members.length}}" description="还没有编入角色，先去角色图鉴挑几位" />

  <t-popup visible="{{pickerVisible}}" placement="bottom" bind:visible-change="onPopupChange">
    <view class="picker">
      <view class="picker__head">
        <text class="picker__title">{{pickerType === 'qibo' ? '选择出战奇波' : '选择角色'}}</text>
        <text class="picker__close" bindtap="closePicker">完成</text>
      </view>
      <scroll-view class="picker__list" scroll-y>
        <view
          class="picker__item {{item.disabled ? 'picker__item--off' : ''}}"
          wx:for="{{pickerItems}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="pickItem"
        >
          <view class="picker__badge" style="color: {{item.elementColor}}; background: {{item.elementTint}};">
            {{item.elementName}}
          </view>
          <view class="picker__body">
            <view class="picker__name">{{item.name}}</view>
            <view class="picker__desc">{{item.desc}}</view>
          </view>
          <t-icon wx:if="{{item.added}}" name="check" size="34rpx" color="#2f6bff" />
          <t-icon wx:else name="add-circle" size="34rpx" color="#c2c9d6" />
        </view>
      </scroll-view>
    </view>
  </t-popup>
</view>
