.skill {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.skill:last-child {
  border-bottom: none;
}

.skill__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.skill__name {
  font-size: 27rpx;
  font-weight: 600;
}

.skill__desc {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.65;
}

.counter {
  display: flex;
  gap: 20rpx;
}

.counter__col {
  flex: 1;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-md);
  background: #f7f9fd;
}

.counter__label {
  color: var(--ink-3);
  font-size: 22rpx;
}

.counter__value {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
}
