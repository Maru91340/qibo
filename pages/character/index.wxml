<view class="page">
  <view class="filter-bar card">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜角色、定位、配队思路"
      bind:change="onKeywordChange"
      bind:clear="onClear"
    />
    <scroll-view class="filter-row" scroll-x enable-flex>
      <t-check-tag
        wx:for="{{roleOptions}}"
        wx:key="*this"
        checked="{{item === role}}"
        variant="light"
        size="large"
        content="{{item}}"
        bind:change="onRoleChange"
        data-value="{{item}}"
      />
    </scroll-view>
    <scroll-view class="filter-row" scroll-x enable-flex>
      <t-check-tag
        wx:for="{{rarityOptions}}"
        wx:key="*this"
        checked="{{item === rarity}}"
        variant="light"
        size="large"
        content="{{item}}"
        bind:change="onRarityChange"
        data-value="{{item}}"
      />
    </scroll-view>
    <view class="element-row">
      <view
        class="element-pill {{item.key === element ? 'element-pill--active' : ''}}"
        wx:for="{{elementOptions}}"
        wx:key="key"
        data-value="{{item.key}}"
        bindtap="onElementChange"
      >
        <view class="element-pill__dot" style="background: {{item.color}};">{{item.name}}</view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="list-head">
    <text>共 {{list.length}} 名角色</text>
    <text class="text-muted" wx:if="{{teamCount}}">已编入 {{teamCount}} 名</text>
  </view>

  <view class="entry-list">
    <view class="entry-card card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="entry-card__badge" style="color: {{item.elementColor}}; background: {{item.elementTint}};">
        {{item.elementName}}
      </view>
      <view class="entry-card__body">
        <view class="entry-card__title">
          <text>{{item.name}}</text>
          <t-tag wx:if="{{!item.verified}}" size="small" variant="light" theme="warning">示例</t-tag>
          <t-tag size="small" variant="light" theme="primary">{{item.rarity}}</t-tag>
          <t-tag size="small" variant="light" theme="success">{{item.role}}</t-tag>
        </view>
        <view class="entry-card__desc">{{item.desc}}</view>
        <view class="chip-row">
          <text class="chip chip--ghost" wx:for="{{item.teams}}" wx:for-item="team" wx:key="*this">{{team}}</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="#c2c9d6" />
    </view>
  </view>

  <t-empty wx:if="{{!list.length}}" description="没有符合条件的角色" />
  <view class="footnote">{{notice}}</view>
</view>
