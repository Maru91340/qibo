.stages {
  display: flex;
  align-items: flex-start;
}

.stage {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stage:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 26rpx;
  left: calc(50% + 34rpx);
  width: calc(100% - 68rpx);
  height: 2rpx;
  background: linear-gradient(90deg, #c7d4f5, #e8ebf3);
}

.stage__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.stage:last-child .stage__dot {
  background: var(--brand);
  color: #fff;
}

.stage__name {
  color: var(--ink-2);
  font-size: 22rpx;
}

.skill {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.skill:last-child {
  border-bottom: none;
}

.skill__name {
  font-size: 26rpx;
}
