{
  "name": "qbxzs",
  "version": "1.0.0",
  "private": true,
  "description": "奇波小助手：《蓝色星原：旅谣》图鉴与工具小程序（uni-app + 微信云开发 + TDesign）",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.11 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "npm:mp": "node scripts/build-npm.mjs dist/dev/mp-weixin",
    "dev:h5": "uni",
    "build:mp-weixin": "node scripts/check.mjs && uni build -p mp-weixin && node scripts/prune-package-assets.mjs && node scripts/build-npm.mjs && node scripts/sync-cloudfunctions.mjs && node scripts/check-package-size.mjs",
    "build:h5": "uni build",
    "check": "node scripts/check.mjs",
    "images:wiki": "node scripts/build-wiki-runtime.mjs",
    "check:size": "node scripts/check-package-size.mjs",
    "test": "node --test \"cloudfunctions/shared/tests/*.test.js\"",
    "test:data": "node scripts/assert-catalogs.mjs",
    "audit:release": "node scripts/check-audit.mjs",
    "release:check": "npm test && npm run check && npm run test:data && npm run build:h5 && npm run build:mp-weixin && npm run audit:release",
    "seed:export": "node scripts/export-seed.mjs",
    "icons": "node scripts/export-icons.mjs",
    "cloud:deploy": "node scripts/deploy-cloudfunctions.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "pako": "1.0.11",
    "tdesign-miniprogram": "^1.17.0",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@cloudbase/manager-node": "^5.10.5",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "esbuild": "0.20.2",
    "miniprogram-automator": "^0.13.0",
    "vite": "5.2.8"
  }
}
